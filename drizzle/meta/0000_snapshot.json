      "checkConstraints": {
        "products_slug_kebab": {
          "name": "products_slug_kebab",
          "value": "\"products\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'"
        },
        "products_price_positive": {
          "name": "products_price_positive",
          "value": "\"products\".\"price\" > 0"
        },
        "products_lead_time_range": {
          "name": "products_lead_time_range",
          "value": "\"products\".\"lead_time_hours\" BETWEEN 24 AND 336"
        },
        "products_summary_length": {
          "name": "products_summary_length",
          "value": "char_length(\"products\".\"summary\") BETWEEN 20 AND 110"
        },
        "products_description_size": {
          "name": "products_description_size",
          "value": "array_length(\"products\".\"description\", 1) BETWEEN 1 AND 4"
        },
        "products_ocasiones_not_empty": {
          "name": "products_ocasiones_not_empty",
          "value": "array_length(\"products\".\"ocasiones\", 1) >= 1"
        },
        "products_image_heights_size": {
          "name": "products_image_heights_size",
          "value": "array_length(\"products\".\"image_heights\", 1) BETWEEN 2 AND 3"
        },
        "products_on_request_is_from": {
          "name": "products_on_request_is_from",
          "value": "NOT (\"products\".\"price_on_request\" AND NOT \"products\".\"price_from\")"
        }
      },
