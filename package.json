{
  "name": "boquita",
  "version": "0.1.0",
  "private": true,
  "description": "Boquita — Sweet & Salty · repostería artesanal en Santa Ana, Costa Rica",
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"require('node:fs').rmSync(process.env.NEXT_DIST_DIR || '.next',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "images:extract": "python scripts/extract-pdf-images.py",
    "images:build": "node scripts/build-images.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-catalog.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.5",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
