# ── Base de datos (Neon, AWS us-east-1) ────────────────────────────────
# Fase 2. Hasta entonces el sitio funciona con content/*.ts como fuente.
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-1.aws.neon.tech/boquita?sslmode=require
DATABASE_URL_UNPOOLED=postgres://...   # TCP, sólo lo usa drizzle-kit para migraciones

# ── Auth del admin (fase 3) ────────────────────────────────────────────
AUTH_SECRET=                # openssl rand -base64 32
ADMIN_PASSWORD_HASH=        # npm run hash-password
ADMIN_SESSION_TTL_HOURS=168
ADMIN_TOKEN_VERSION=1       # subir este número invalida todas las sesiones

# ── Anti-abuso (fase 5) ────────────────────────────────────────────────
FORM_HMAC_SECRET=           # openssl rand -base64 32
IP_SALT=                    # openssl rand -base64 16
RATE_LIMIT_NEWSLETTER_PER_DAY=10

# ── Almacenamiento (Vercel lo inyecta al enlazar un store de Blob) ──────
BLOB_READ_WRITE_TOKEN=

# ── Público ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_PHONE=50662762196          # sólo dígitos, sin + ni espacios
NEXT_PUBLIC_CONTACT_EMAIL=ticaboquita@gmail.com
