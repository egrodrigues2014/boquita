# ── Base de datos (Neon, AWS us-east-1) ────────────────────────────────
# Las DOS son la misma cadena y se diferencian en UNA palabra del host: la
# primera lleva `-pooler`, la segunda no. Copiarlas del panel «Connect» de Neon
# activando y desactivando «Connection pooling»; NO construirlas a mano.
#
# Opcionales: sin ellas el sitio sirve content/products.ts y todo funciona
# (tests, build y e2e incluidos). Ver el contrato del fallback en lib/db/catalog.ts.
#
# La pooled la usa la APLICACIÓN: PgBouncer, muchas conexiones cortas.
DATABASE_URL=postgresql://neondb_owner:pass@ep-xxx-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require
# La directa la usa DRIZZLE-KIT para migrar: PgBouncer en modo transacción no
# soporta el estado de sesión que necesitan (`SET`, `LISTEN/NOTIFY`).
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:pass@ep-xxx.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Auth del admin (fase 3) ────────────────────────────────────────────
AUTH_SECRET=                # openssl rand -base64 32
ADMIN_PASSWORD_HASH=        # ⚠ el script que lo genera no existe todavía (fase 3)
ADMIN_SESSION_TTL_HOURS=168
ADMIN_TOKEN_VERSION=1       # subir este número invalida todas las sesiones

# ── Formularios y anti-abuso ───────────────────────────────────────────
FORM_HMAC_SECRET=           # openssl rand -base64 32
IP_SALT=                    # openssl rand -base64 16
RATE_LIMIT_ORDER_PER_DAY=20 # intentos nuevos por hash de IP y día; reintentos no consumen

# ── Publicación ────────────────────────────────────────────────────────
# Sólo `true` después de validar HTTPS y DNS en el dominio definitivo.
SITE_LAUNCHED=false

# ── Revalidación de la caché del catálogo ──────────────────────────────
# Sin esto, `npm run db:seed` no se ve hasta una hora después: el catálogo vive
# en un `unstable_cache` de 3600s y las páginas en ISR con el mismo reloj.
# `app/api/revalidate/route.ts` las tira las dos; la semilla lo llama al acabar.
# Si falta, la ruta responde 503 (apagada, no abierta) y la semilla sólo avisa.
REVALIDATE_SECRET=          # openssl rand -base64 32
# Opcional: a quién avisar. Por defecto, NEXT_PUBLIC_SITE_URL. Se pone para
# sembrar desde local y refrescar producción.
REVALIDATE_URL=

# ── Almacenamiento (Vercel lo inyecta al enlazar un store de Blob) ──────
BLOB_READ_WRITE_TOKEN=

# ── Público ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
